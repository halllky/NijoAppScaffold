{
  "MyApp": {
    "LogDirectory": "../WebApi.Log",
    "MigrationsScriptFolder": "../Core/MigrationsScript",
    "BusinessTimeZone": "Asia/Tokyo",
    "CurrentDbProfileName": "Development - SQLite",
    "DbProfiles": [
      {
        "Name": "Development - SQLite",
        "ConnStr": "Data Source=../DEBUG.sqlite3;Pooling=False;"
      }
    ],
    "商品管理システム": {
      "UseMock": true
    },
    "ErrorNotification": {
      "UseMock": true,
      "MockOutputDirectory": "運用担当への通知（モック）",
      "DefaultRecipients": [
        "ops@example.com"
      ],
      "ThrottleMinutes": 10
    },
    "Job": {
      "WorkDirectory": "../WebApi.Job",
      "MaxConcurrency": 1,
      "ShutdownTimeoutSeconds": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
